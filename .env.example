# .env.example — a TEMPLATE of the settings DataTrust needs. Contains NO real values.
# How to use: copy this file to ".env" and fill in your own values.
# ".env" is listed in .gitignore, so your real token is never committed.

# Hugging Face access token (free). Create one at https://huggingface.co/settings/tokens
# Use a "Read" token for collecting data. A "Write" token is only needed later (Step 4)
# to upload results to your HF dataset repo.
HF_TOKEN=

# How many datasets to collect (start small, grow later).
MAX_DATASETS=5000
